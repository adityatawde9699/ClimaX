# ClimaX frontend configuration. Copy to apps/web/.env for local development.
# NEXT_PUBLIC_* values are included in the browser bundle at build time.

NODE_ENV=development
WEB_PORT=3000
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
NEXT_PUBLIC_DEMO_MODE=false

# Optional Google login. Match the API's GOOGLE_OAUTH_CLIENT_ID.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=

# Optional browser-side integrations.
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=

# OpenStreetMap alternative. No API key is required for standard tiles.
NEXT_PUBLIC_MAP_PROVIDER=osm
NEXT_PUBLIC_OSM_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
