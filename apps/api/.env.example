# ClimaX API configuration. Copy to apps/api/.env for local development.
# Use deployment secrets for production credentials. Never commit apps/api/.env.

ENVIRONMENT=development
DEBUG=false
ENABLE_API_DOCS=true
ENABLE_DEMO_LOGIN=false
LOG_LEVEL=DEBUG
PORT=8000
PROJECT_NAME="ClimaX Platform API"
VERSION=0.1.0
API_V1_STR=/api/v1
API_BASE_URL=http://localhost:8000
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]

# PostgreSQL 16 with PostGIS. Use the container hostname `postgres` when the
# API itself runs inside the local all-in-one Docker Compose stack.
DB_HOST=localhost
DB_PORT=5432
DB_USER=climax_user
DB_PASSWORD=climax_dev_password
DB_NAME=climax_db
DB_SSL_MODE=disable
DATABASE_URL=postgresql+asyncpg://climax_user:climax_dev_password@localhost:5432/climax_db
DATABASE_SYNC_URL=postgresql+psycopg2://climax_user:climax_dev_password@localhost:5432/climax_db
DB_POOL_SIZE=20
DB_MAX_OVERFLOW=10
DB_TIMEOUT_SECONDS=3

# Auth. Use a unique secret of at least 32 characters in production.
JWT_SECRET_KEY=development-secret-key-change-in-production-32-chars
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7
HASH_SALT_ROUNDS=12
GOOGLE_OAUTH_CLIENT_ID=
AUTHORITY_REGISTRATION_CODE=
RISK_AUTO_INCIDENT_ORGANIZATION_ID=

# Optional provider-backed features.
GCP_PROJECT_ID=
GCP_REGION=us-central1
GOOGLE_APPLICATION_CREDENTIALS=
GOOGLE_APPLICATION_CREDENTIALS_JSON=
GCP_API_SERVICE_ACCOUNT=
GCP_WORKER_SERVICE_ACCOUNT=
GEMINI_API_KEY=
GEMINI_MODEL_TEXT=gemini-1.5-pro
GEMINI_MODEL_FLASH=gemini-1.5-flash
GEMINI_MODEL_MULTIMODAL=gemini-1.5-pro
GEMINI_MAX_TOKENS=4096
GEMINI_TEMPERATURE=0.2
VERTEX_AI_PROJECT_ID=
VERTEX_AI_LOCATION=us-central1
VERTEX_AI_ENDPOINT_POLLUTION_PREDICTION=
VERTEX_AI_ENDPOINT_SOURCE_ATTRIBUTION=
GOOGLE_MAPS_SERVER_KEY=
MAPS_DEFAULT_LAT=28.6139
MAPS_DEFAULT_LNG=77.2090
MAPS_DEFAULT_ZOOM=11

# OpenStreetMap alternative. No API key is required for standard tiles.
OSM_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png
NOMINATIM_BASE_URL=https://nominatim.openstreetmap.org
NOMINATIM_USER_AGENT=ClimaX/0.1.0 (contact: your-email@example.com)
OVERPASS_API_URL=https://overpass-api.de/api/interpreter
EARTH_ENGINE_SERVICE_ACCOUNT=
EARTH_ENGINE_PRIVATE_KEY_PATH=
GCS_BUCKET_MEDIA=
GCS_BUCKET_GEOSPATIAL=
GCS_BUCKET_EXPORTS=
GCS_BUCKET=
GCS_SIGNED_URL_EXPIRY_MINUTES=15
MAX_REPORT_UPLOAD_BYTES=10000000
PUBSUB_TOPIC_SENSOR_INGESTION=
PUBSUB_TOPIC_CITIZEN_REPORTS=
PUBSUB_TOPIC_AI_DISPATCH=
PUBSUB_TOPIC_ALERTS=
PUBSUB_SENSOR_SUBSCRIPTION=climax-sensor-ingest-sub
PUBSUB_SUBSCRIPTION_REPORT_PROCESSOR=
PUBSUB_SUBSCRIPTION_AI_DISPATCH=
PUBSUB_SUBSCRIPTION_ALERT_DISPATCH=
PUBSUB_EMULATOR_HOST=
BIGQUERY_DATASET_RAW=climax_environmental_raw
BIGQUERY_DATASET_ANALYTICS=climax_environmental_analytics
BIGQUERY_TABLE_OBSERVATIONS=sensor_observations_partitioned
OPEN_METEO_BASE_URL=https://api.open-meteo.com/v1/forecast
OPENWEATHER_API_KEY=
COPERNICUS_CDS_API_KEY=
NOAA_DATA_API_TOKEN=

# Cache. Cache failures are non-fatal.
REDIS_URL=redis://localhost:6379/0
PREDICTION_CACHE_TTL_SECONDS=3600
RISK_CACHE_TTL_SECONDS=900
REDIS_PASSWORD=

# Optional delivery and telemetry settings.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
FCM_PROJECT_ID=
FCM_SERVICE_ACCOUNT_JSON=
GOOGLE_STT_LANGUAGE_CODES=en-US,hi-IN,es-ES,fr-FR
GOOGLE_TRANSLATE_TARGET_LANGUAGES=en,hi,es,fr
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
OTEL_SERVICE_NAME=climax-api
SENTRY_DSN=
PROMETHEUS_MULTIPROC_DIR=

# Test tooling only. Never enable database tests against production.
RUN_DATABASE_TESTS=0
API_URL=http://localhost:8000/api/v1
