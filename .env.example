# ==============================================================================
# ClimaX Platform — Environment Configuration Template
# ==============================================================================
# NOTICE: This file defines all environment variables required across ClimaX.
# Copy this file to .env before starting local development:
#   cp .env.example .env
# NEVER commit real credentials, service account keys, or API tokens to source control.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. APPLICATION ENVIRONMENT & NETWORKING
# ------------------------------------------------------------------------------
NODE_ENV=development
ENVIRONMENT=development
DEBUG=false
LOG_LEVEL=DEBUG
PORT=8000
WEB_PORT=3000
PROJECT_NAME="ClimaX Platform API"
VERSION=0.1.0
API_V1_STR=/api/v1
API_BASE_URL=http://localhost:8000
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
# Pydantic list values must be JSON arrays.
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]

# ------------------------------------------------------------------------------
# 2. DATABASE (PostgreSQL + PostGIS)
# ------------------------------------------------------------------------------
DB_HOST=localhost
DB_PORT=5432
DB_USER=climax_user
DB_PASSWORD=climax_secure_dev_password
DB_NAME=climax_db
DB_SSL_MODE=disable
DATABASE_URL=postgresql+asyncpg://${DB_USER}:${DB_PASSWORD}@${DB_HOST}:${DB_PORT}/${DB_NAME}
DATABASE_SYNC_URL=postgresql+psycopg2://${DB_USER}:${DB_PASSWORD}@${DB_HOST}:${DB_PORT}/${DB_NAME}

# Pool configurations
DB_POOL_SIZE=20
DB_MAX_OVERFLOW=10
DB_TIMEOUT_SECONDS=30

# ------------------------------------------------------------------------------
# 3. GOOGLE CLOUD PLATFORM (Core)
# ------------------------------------------------------------------------------
GCP_PROJECT_ID=climax-prod-project-id
GCP_REGION=us-central1
GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account-key.json
# Optional alternative for secret injection; keep empty when using ADC/file credentials.
GOOGLE_APPLICATION_CREDENTIALS_JSON=
GCP_API_SERVICE_ACCOUNT=climax-api@climax-prod-project-id.iam.gserviceaccount.com
GCP_WORKER_SERVICE_ACCOUNT=climax-workers@climax-prod-project-id.iam.gserviceaccount.com

# ------------------------------------------------------------------------------
# 4. GEMINI API & GOOGLE AI STUDIO
# ------------------------------------------------------------------------------
# API Key for Gemini Developer API / Google AI Studio
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL_TEXT=gemini-1.5-pro
GEMINI_MODEL_FLASH=gemini-1.5-flash
GEMINI_MODEL_MULTIMODAL=gemini-1.5-pro
GEMINI_MAX_TOKENS=4096
GEMINI_TEMPERATURE=0.2

# ------------------------------------------------------------------------------
# 5. VERTEX AI (Prediction & Enterprise Models)
# ------------------------------------------------------------------------------
VERTEX_AI_PROJECT_ID=climax-prod-project-id
VERTEX_AI_LOCATION=us-central1
VERTEX_AI_ENDPOINT_POLLUTION_PREDICTION=projects/climax-prod-project-id/locations/us-central1/endpoints/1234567890
VERTEX_AI_ENDPOINT_SOURCE_ATTRIBUTION=projects/climax-prod-project-id/locations/us-central1/endpoints/0987654321

# ------------------------------------------------------------------------------
# 6. GOOGLE MAPS PLATFORM
# ------------------------------------------------------------------------------
# Public API key for client-side map rendering and geospatial tiles
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=your_google_maps_browser_key_here
# Server-side API key for geocoding, reverse geocoding, and elevation APIs
GOOGLE_MAPS_SERVER_KEY=your_google_maps_server_key_here
MAPS_DEFAULT_LAT=28.6139
MAPS_DEFAULT_LNG=77.2090
MAPS_DEFAULT_ZOOM=11

# ------------------------------------------------------------------------------
# 7. GOOGLE EARTH ENGINE
# ------------------------------------------------------------------------------
EARTH_ENGINE_SERVICE_ACCOUNT=climax-earth-engine@climax-prod-project-id.iam.gserviceaccount.com
EARTH_ENGINE_PRIVATE_KEY_PATH=/path/to/earth-engine-key.pem

# ------------------------------------------------------------------------------
# 8. FIREBASE (Auth & Realtime Client Notifications)
# ------------------------------------------------------------------------------
NEXT_PUBLIC_FIREBASE_API_KEY=your_firebase_web_api_key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=climax-prod-project-id.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=climax-prod-project-id
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=climax-prod-project-id.appspot.com
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=1234567890
NEXT_PUBLIC_FIREBASE_APP_ID=1:1234567890:web:abcdef123456

# ------------------------------------------------------------------------------
# 9. GOOGLE CLOUD STORAGE (Citizen Media & GeoTIFFs)
# ------------------------------------------------------------------------------
GCS_BUCKET_MEDIA=climax-citizen-media
GCS_BUCKET_GEOSPATIAL=climax-geospatial-assets
GCS_BUCKET_EXPORTS=climax-researcher-exports
# Current backend adapter setting (normally the same as GCS_BUCKET_MEDIA).
GCS_BUCKET=climax-citizen-media
GCS_SIGNED_URL_EXPIRY_MINUTES=15

# ------------------------------------------------------------------------------
# 10. GOOGLE CLOUD PUB/SUB (Streaming Ingestion & Event Bus)
# ------------------------------------------------------------------------------
PUBSUB_TOPIC_SENSOR_INGESTION=projects/climax-prod-project-id/topics/climax-sensor-ingest
PUBSUB_TOPIC_CITIZEN_REPORTS=projects/climax-prod-project-id/topics/climax-citizen-reports
PUBSUB_TOPIC_AI_DISPATCH=projects/climax-prod-project-id/topics/climax-ai-dispatch
PUBSUB_TOPIC_ALERTS=projects/climax-prod-project-id/topics/climax-alerts-dispatch
PUBSUB_SENSOR_SUBSCRIPTION=climax-sensor-ingest-sub
PUBSUB_SUBSCRIPTION_REPORT_PROCESSOR=projects/climax-prod-project-id/subscriptions/climax-citizen-reports-sub
PUBSUB_SUBSCRIPTION_AI_DISPATCH=projects/climax-prod-project-id/subscriptions/climax-ai-dispatch-sub
PUBSUB_SUBSCRIPTION_ALERT_DISPATCH=projects/climax-prod-project-id/subscriptions/climax-alerts-dispatch-sub
# Set only when running the local Pub/Sub emulator, e.g. localhost:8085.
PUBSUB_EMULATOR_HOST=

# ------------------------------------------------------------------------------
# 11. BIGQUERY (Analytical Warehouse & Historical Datasets)
# ------------------------------------------------------------------------------
BIGQUERY_DATASET_RAW=climax_environmental_raw
BIGQUERY_DATASET_ANALYTICS=climax_environmental_analytics
BIGQUERY_TABLE_OBSERVATIONS=sensor_observations_partitioned

# ------------------------------------------------------------------------------
# 12. WEATHER & METEOROLOGICAL EXTERNAL APIS
# ------------------------------------------------------------------------------
# Used by the current Open-Meteo adapter; no credential is required.
OPEN_METEO_BASE_URL=https://api.open-meteo.com/v1/forecast
# Optional alternative providers for future adapters.
OPENWEATHER_API_KEY=your_openweather_api_key_here
COPERNICUS_CDS_API_KEY=your_copernicus_cds_key_here
NOAA_DATA_API_TOKEN=your_noaa_token_here

# ------------------------------------------------------------------------------
# 13. AUTHENTICATION & SECURITY (JWT & RBAC)
# ------------------------------------------------------------------------------
JWT_SECRET_KEY=generate_a_secure_32_byte_random_string_here_for_dev_only
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7
HASH_SALT_ROUNDS=12

# ------------------------------------------------------------------------------
# 14. REDIS CACHE
# ------------------------------------------------------------------------------
REDIS_URL=redis://localhost:6379/0
REDIS_PASSWORD=
PREDICTION_CACHE_TTL_SECONDS=3600
RISK_CACHE_TTL_SECONDS=900

# ------------------------------------------------------------------------------
# 15. ALERT DELIVERY PROVIDERS (optional until enabled)
# ------------------------------------------------------------------------------
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
FCM_PROJECT_ID=climax-prod-project-id
FCM_SERVICE_ACCOUNT_JSON=

# ------------------------------------------------------------------------------
# 16. SPEECH-TO-TEXT & TRANSLATION APIS
# ------------------------------------------------------------------------------
GOOGLE_STT_LANGUAGE_CODES=en-US,hi-IN,es-ES,fr-FR
GOOGLE_TRANSLATE_TARGET_LANGUAGES=en,hi,es,fr

# ------------------------------------------------------------------------------
# 17. OBSERVABILITY & TELEMETRY
# ------------------------------------------------------------------------------
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
OTEL_SERVICE_NAME=climax-api
SENTRY_DSN=https://examplePublicKey@o0.ingest.sentry.io/0
PROMETHEUS_MULTIPROC_DIR=

# ------------------------------------------------------------------------------
# 18. TESTING & CI (never enable against production)
# ------------------------------------------------------------------------------
RUN_DATABASE_TESTS=0
API_URL=http://localhost:8000/api/v1
